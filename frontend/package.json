{
  "name": "bookvie-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts' 'scripts/**/*.mjs' '*.ts' '../scripts/*.mjs'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' 'e2e/**/*.ts' 'scripts/**/*.mjs' '*.ts' '../scripts/*.mjs'",
    "preview": "vite preview",
    "api:gen": "node scripts/api-contract.mjs --write",
    "check:api": "node scripts/api-contract.mjs && npm run format:check && tsc -b && oxlint && node --test 'src/**/*.test.ts' 'scripts/*.test.mjs'",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-router": "~8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "~7.13.0",
    "oxlint": "^1.89.0",
    "prettier": "~3.6.2",
    "typescript": "~5.9.3",
    "vite": "~8.3.5"
  }
}
